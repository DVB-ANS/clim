# Vercel deploys the dashboard only: the project's Root Directory is app/, and `vercel deploy --prod` runs
# from the repo root. Upload app/ and nothing else. `npm run sync` (in app/) has already copied what the
# build reads from shared/, lab/out and docs/faq.md into app/src/generated and app/public/data (committed).
/*
!/app
/app/node_modules
/app/.next
/app/.vercel
/app/.env*
!/app/.env.example
/app/coverage
/app/*.tsbuildinfo
